generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // For connection pooling
  directUrl = env("DIRECT_URL") // For migrations/db push
}

model User {
  id          Int       @id @default(autoincrement())
  fullName    String
  email       String    @unique
  password    String
  phoneNumber String?
  degree      String?
  country     String?
  city        String?
  dateOfBirth DateTime?
  diplomaId   Int?
  role        String    @default("USER")
  imagePath   String?
  sessions    Session[]
  diploma     Diploma?  @relation(fields: [diplomaId], references: [id])
  courses     Course[]  @relation("CourseToUser")
}

model Instructor {
  id        Int      @id @default(autoincrement())
  name      String
  specialty String
  imagePath String?
  courses   Course[]
}

model Diploma {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime
  finishDate  DateTime
  price       Float
  room        String?
  courses     Course[]
  users       User[]
}

model Course {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  startDate    DateTime
  finishDate   DateTime
  price        Float
  room         String?
  instructorId Int
  diplomaId    Int?
  diploma      Diploma?   @relation(fields: [diplomaId], references: [id])
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  users        User[]     @relation("CourseToUser")
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imagePath   String?
  place       String?
  startDate   DateTime
  finishDate  DateTime
  link        String?
}

model ContactUs {
  id    Int      @id @default(autoincrement())
  name  String
  date  DateTime @default(now())
  phone String
  email String
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
